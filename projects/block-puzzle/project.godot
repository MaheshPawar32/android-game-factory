; BLOCKVERSE — Godot 4.4
config_version=5

[application]
config/name="BLOCKVERSE"
config/description="PLACE. CLEAR. COMBO. CONQUER."
config/version="0.1.0"
run/main_scene="res://scenes/home.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")

[autoload]
SaveData="*res://scripts/autoload/save_data.gd"
AppRouter="*res://scripts/autoload/app_router.gd"

[display]
window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=432
window/size/window_height_override=768
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.063, 0.078, 0.149, 1)
